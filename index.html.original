<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f3ed">
  <meta name="description" content="A visual journal by Albin Baby — photographs, places, and quiet moments.">
  <title>Albin Baby — Visual Journal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manjari:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet">
  <style>
    :root{--paper:#f5f3ed;--ink:#183b38;--muted:#6f7d76;--line:#d9ddd5;--accent:#cf694d;--green:#16443d;--white:#fffefa;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif;--ml:'Manjari','Noto Sans Malayalam',sans-serif}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;scroll-padding-top:94px}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}
    body.ml{font-family:var(--ml)}
    a{color:inherit;text-decoration:none}
    button{font:inherit;color:inherit}
    .shell{width:min(1180px,calc(100% - 64px));margin:auto}
    .topbar{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10;background:rgba(245,243,237,.9);backdrop-filter:blur(16px)}
    .brand{display:flex;align-items:center;gap:11px;font-size:14px;font-weight:700;letter-spacing:.04em}
    .brand-mark{width:34px;height:34px;border:1px solid #9dada1;border-radius:50%;display:grid;place-items:center;font:italic 18px var(--serif);color:var(--accent)}
    .nav{display:flex;align-items:center;gap:36px;font-size:12px;letter-spacing:.06em;color:#52635c}
    .nav a{transition:color .2s}.nav a:hover{color:var(--accent)}
    .right-tools{display:flex;gap:18px;align-items:center}
    .lang-switch{border:1px solid var(--line);border-radius:99px;padding:4px;display:flex;gap:2px;background:#efeee8}
    .lang-switch button{border:0;background:transparent;border-radius:99px;padding:7px 11px;font-size:10px;letter-spacing:.08em;color:#79847d;cursor:pointer;transition:.25s}
    .lang-switch button.active{background:var(--green);color:white}
    .menu-toggle{display:none;border:0;background:none;font-size:22px;cursor:pointer}
    .hero{display:grid;grid-template-columns:1.12fr .88fr;align-items:center;gap:70px;padding:82px 0 92px;min-height:620px}
    .eyebrow{display:flex;align-items:center;gap:12px;color:var(--accent);font-size:10px;letter-spacing:.2em;text-transform:uppercase;font-weight:700}
    .eyebrow:before{content:'';width:32px;height:1px;background:currentColor}
    h1{font:500 clamp(54px,7.5vw,94px)/.98 var(--serif);letter-spacing:-.055em;margin:25px 0 23px;max-width:650px}
    h1 em{font-weight:500;color:var(--accent)}
    .hero-copy{max-width:480px;color:#66766e;font-size:15px;line-height:1.85;margin:0 0 31px}
    .hero-actions{display:flex;align-items:center;gap:25px}
    .button{display:inline-flex;align-items:center;gap:13px;border-radius:3px;padding:15px 20px;background:var(--green);color:white;font-size:11px;letter-spacing:.07em;transition:transform .25s,background .25s}
    .button:hover{transform:translateY(-3px);background:#20574d}
    .text-link{font-size:11px;color:#63736b;border-bottom:1px solid #aab5ab;padding-bottom:5px}
    .hero-visual{position:relative;max-width:440px;justify-self:end;width:100%;padding:0 24px 24px 0}
    .portrait-wrap{height:460px;overflow:hidden;position:relative;background:#d5d9d2;border-radius:48% 48% 3px 3px}
    .portrait-wrap:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(13,34,31,.24))}
    .portrait{width:100%;height:100%;object-fit:cover;object-position:center 25%;filter:grayscale(100%);transition:transform .8s cubic-bezier(.2,.7,.2,1)}
    .hero-visual:hover .portrait{transform:scale(1.035)}
    .visual-outline{position:absolute;inset:17px 0 0 20px;border:1px solid #b9c0b5;border-radius:48% 48% 3px 3px;z-index:-1}
    .portrait-caption{position:absolute;bottom:43px;left:25px;color:white;font-size:10px;letter-spacing:.16em;text-transform:uppercase;z-index:1}
    .photo-count{position:absolute;right:-15px;top:74px;background:var(--white);border-radius:50%;width:102px;height:102px;display:grid;place-content:center;text-align:center;box-shadow:0 12px 40px #1c32241a;transform:rotate(8deg)}
    .photo-count strong{font:italic 27px var(--serif);color:var(--accent)}
    .photo-count span{font-size:8px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
    .hero-note{position:absolute;bottom:-5px;right:0;font:italic 15px var(--serif);color:#718079;transform:rotate(-5deg)}
    .marquee{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:16px 0;overflow:hidden;color:#718078;font:italic 17px var(--serif);white-space:nowrap;letter-spacing:.03em}
    .marquee span{display:inline-block;padding-right:42px}.marquee b{font:normal 10px var(--sans);color:var(--accent);padding:0 18px}
    .gallery-section{padding:88px 0 108px}
    .section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:34px;gap:20px}
    .section-heading .eyebrow{margin-bottom:14px}
    h2{font:500 clamp(36px,5vw,56px)/1.1 var(--serif);letter-spacing:-.04em;margin:0}
    h2 em{color:var(--accent)}
    .section-intro{font-size:12px;color:var(--muted);max-width:265px;line-height:1.7;margin:0 0 4px}
    .filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:30px}
    .filter{border:1px solid var(--line);background:transparent;border-radius:99px;padding:9px 15px;font-size:10px;letter-spacing:.05em;color:#758078;cursor:pointer;transition:all .2s}
    .filter:hover,.filter.active{background:var(--green);border-color:var(--green);color:white}
    .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:start}
    .card{position:relative;overflow:hidden;background:#e2e4dc;cursor:pointer;min-height:230px;isolation:isolate;animation:card-in .45s both}
    .card:nth-child(6n+1){aspect-ratio:4/5}.card:nth-child(6n+2){aspect-ratio:1/1}.card:nth-child(6n+3){aspect-ratio:4/5.5}.card:nth-child(6n+4){aspect-ratio:1/1}.card:nth-child(6n+5){aspect-ratio:4/5}.card:nth-child(6n){aspect-ratio:1/1.12}
    .card[hidden]{display:none}
    .card img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;transition:transform .65s cubic-bezier(.2,.7,.2,1),filter .5s;filter:saturate(.89)}
    .card:hover img{transform:scale(1.055);filter:saturate(1.06)}
    .card:after{content:'';position:absolute;inset:35% 0 0;background:linear-gradient(transparent,rgba(14,34,31,.67));z-index:0;opacity:.82;transition:opacity .3s}
    .card:hover:after{opacity:1}
    .card-info{position:absolute;z-index:1;bottom:16px;left:17px;right:17px;display:flex;align-items:end;justify-content:space-between;color:white}
    .card-category{font-size:9px;letter-spacing:.16em;text-transform:uppercase;opacity:.88}
    .card-number{font:italic 17px var(--serif);opacity:.9}
    .card-arrow{position:absolute;top:13px;right:13px;width:34px;height:34px;border-radius:50%;background:#f5f3eddc;display:grid;place-items:center;z-index:1;opacity:0;transform:translateY(5px);transition:.25s}
    .card:hover .card-arrow{opacity:1;transform:translateY(0)}
    .about{background:var(--green);color:#f7f4eb;padding:86px 0;position:relative;overflow:hidden}
    .about:after{content:'AB';position:absolute;right:4%;top:-98px;font:600 370px/.9 var(--serif);color:#ffffff08;pointer-events:none}
    .about-inner{display:grid;grid-template-columns:.72fr 1.28fr;gap:90px;align-items:center;position:relative;z-index:1}
    .about .eyebrow{color:#df9b7e}
    .about h2{font-size:clamp(40px,5vw,62px);max-width:340px;margin-top:20px}
    .about h2 em{color:#df9b7e}
    .about-copy{font-size:15px;line-height:1.9;color:#d2ddd4;max-width:570px}
    .about-copy p{margin:0 0 18px}
    .signature{font:italic 18px var(--serif);color:#e5aa91;margin-top:24px}
    .connect{padding:90px 0 74px;text-align:center}
    .connect .eyebrow{justify-content:center}
    .connect h2{margin:18px auto 15px;max-width:620px}
    .connect p{color:var(--muted);font-size:13px;line-height:1.8;margin:0 auto 25px;max-width:460px}
    .connect .button{background:var(--accent)}.connect .button:hover{background:#b8573f}
    .footer{border-top:1px solid var(--line);padding:22px 0;display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#859188;letter-spacing:.04em}
    .footer a{color:var(--ink)}
    .lightbox{position:fixed;inset:0;background:rgba(10,22,20,.94);z-index:30;display:none;align-items:center;justify-content:center;padding:34px}
    .lightbox.open{display:flex;animation:fade-in .2s}
    .lightbox img{max-width:min(82vw,1100px);max-height:82vh;object-fit:contain;box-shadow:0 20px 70px #0005}
    .lightbox button{position:absolute;border:1px solid #ffffff55;background:#ffffff12;color:white;border-radius:50%;width:44px;height:44px;cursor:pointer;font-size:20px;display:grid;place-items:center;transition:background .2s}
    .lightbox button:hover{background:#ffffff35}.lightbox .close{top:22px;right:24px}.lightbox .prev{left:24px}.lightbox .next{right:24px}
    .lightbox-caption{position:absolute;bottom:22px;color:#ffffffbd;font-size:10px;letter-spacing:.15em;text-transform:uppercase}
    .reveal{opacity:0;transform:translateY(20px);transition:opacity .65s,transform .65s}.reveal.visible{opacity:1;transform:none}
    @keyframes card-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
    @keyframes fade-in{from{opacity:0}to{opacity:1}}
    @media(max-width:850px){.shell{width:min(100% - 42px,700px)}.hero{gap:35px;padding:64px 0 76px;min-height:0}.portrait-wrap{height:385px}.nav{gap:19px}.about-inner{gap:45px}.gallery{gap:12px}}
    @media(max-width:620px){.shell{width:calc(100% - 36px)}.topbar{height:68px}.brand{font-size:12px}.brand-mark{width:30px;height:30px}.nav{display:none;position:absolute;top:67px;left:0;right:0;background:var(--paper);padding:17px 22px 22px;border-bottom:1px solid var(--line);flex-direction:column;align-items:flex-start;gap:18px}.nav.open{display:flex}.menu-toggle{display:block}.right-tools{gap:12px}.hero{grid-template-columns:1fr;padding:56px 0 62px;gap:42px}.hero h1{font-size:clamp(56px,15vw,82px);margin-top:21px}.hero-copy{font-size:14px}.hero-visual{justify-self:center;width:min(82%,360px);padding-right:14px}.portrait-wrap{height:390px}.photo-count{right:-22px;width:86px;height:86px}.photo-count strong{font-size:23px}.photo-count span{font-size:7px}.hero-note{right:0;font-size:13px}.marquee{padding:13px 0;font-size:15px}.gallery-section{padding:66px 0 75px}.section-heading{display:block;margin-bottom:25px}.section-intro{margin-top:12px}.filters{gap:6px}.filter{padding:8px 11px;font-size:9px}.gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.card{min-height:175px}.card:nth-child(n){aspect-ratio:4/5}.card:nth-child(4n+2),.card:nth-child(4n+3){aspect-ratio:1/1.12}.card-info{left:10px;right:10px;bottom:11px}.card-category{font-size:8px}.card-number{font-size:15px}.about{padding:65px 0}.about-inner{grid-template-columns:1fr;gap:23px}.about h2{max-width:none;margin-top:13px}.about-copy{font-size:14px}.about:after{font-size:240px;right:-5%;top:-50px}.connect{padding:69px 0 55px}.footer{font-size:9px;gap:10px}.lightbox{padding:18px}.lightbox img{max-width:94vw;max-height:78vh}.lightbox .prev{left:10px}.lightbox .next{right:10px}.lightbox button{width:38px;height:38px}}
    @media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
  </style>
</head>
<body>
  <header class="topbar shell">
    <a class="brand" href="#home" aria-label="Albin Baby home"><span class="brand-mark">a.</span><span>ALBIN BABY</span></a>
    <nav class="nav" id="nav"><a href="#gallery" data-en="THE GALLERY" data-ml="ചിത്രങ്ങൾ">THE GALLERY</a><a href="#about" data-en="ABOUT" data-ml="എന്നെക്കുറിച്ച്">ABOUT</a><a href="#connect" data-en="SAY HELLO" data-ml="ബന്ധപ്പെടാം">SAY HELLO</a></nav>
    <div class="right-tools"><div class="lang-switch" aria-label="Choose language"><button class="active" data-lang="en" aria-pressed="true">EN</button><button data-lang="ml" aria-pressed="false">മലയാളം</button></div><button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false">☰</button></div>
  </header>
  <main>
    <section class="hero shell" id="home">
      <div class="hero-text reveal">
        <div class="eyebrow" data-en="A PERSONAL VISUAL JOURNAL" data-ml="ഒരു ദൃശ്യ ഓർമ്മപ്പുസ്തകം">A PERSONAL VISUAL JOURNAL</div>
        <h1 data-en-html="Finding stories<br>in the <em>stillness.</em>" data-ml-html="നിശ്ശബ്ദതയിലെ<br><em>കഥകൾ.</em>">Finding stories<br>in the <em>stillness.</em></h1>
        <p class="hero-copy" data-en="A little collection of places, passing light, and the small moments that ask us to pause." data-ml="സ്ഥലങ്ങളും വെളിച്ചത്തിന്റെ നിമിഷങ്ങളും ഒന്നു നിൽക്കാൻ പറയുന്ന ചെറിയ കാഴ്ചകളും — എന്റെ ക്യാമറയിൽ പകർത്തിയ ഓർമ്മകൾ.">A little collection of places, passing light, and the small moments that ask us to pause.</p>
        <div class="hero-actions"><a class="button" href="#gallery"><span data-en="EXPLORE THE FRAMES" data-ml="ചിത്രങ്ങൾ കാണാം">EXPLORE THE FRAMES</span><span aria-hidden="true">↘</span></a><a class="text-link" href="https://www.instagram.com/albin___baby___?rpxt=MTN4cXprb3A2dm8ybg==" target="_blank" rel="noreferrer" data-en="Instagram profile ↗" data-ml="ഇൻസ്റ്റഗ്രാം ↗">Instagram profile ↗</a></div>
      </div>
      <div class="hero-visual reveal"><div class="visual-outline"></div><div class="portrait-wrap"><img class="portrait" src="images/866320080_18099670082453028_8059457265895629110_n.jpg" alt="Portrait of Albin Baby" fetchpriority="high"><span class="portrait-caption" data-en="Behind the lens · Albin Baby" data-ml="ക്യാമറയ്ക്ക് പിന്നിൽ · ആൽബിൻ ബേബി">Behind the lens · Albin Baby</span></div><div class="photo-count"><strong>33</strong><span data-en="shared frames" data-ml="ഫോട്ടോകൾ">shared frames</span></div><span class="hero-note" data-en="through my lens" data-ml="എന്റെ കാഴ്ചയിൽ">through my lens</span></div>
    </section>
    <div class="marquee" aria-hidden="true"><span>Moments worth keeping <b>✳</b> Through my lens <b>✳</b> Small details, big feelings <b>✳</b> Moments worth keeping <b>✳</b> Through my lens <b>✳</b></span></div>
    <section class="gallery-section shell" id="gallery">
      <div class="section-heading reveal"><div><div class="eyebrow" data-en="SELECTED PHOTOGRAPHS" data-ml="തിരഞ്ഞെടുത്ത ചിത്രങ്ങൾ">SELECTED PHOTOGRAPHS</div><h2 data-en-html="The <em>gallery</em>" data-ml-html="ചിത്രങ്ങളുടെ <em>ശേഖരം</em>">The <em>gallery</em></h2></div><p class="section-intro" data-en="A few things I noticed along the way. Tap any frame to see it up close." data-ml="യാത്രയ്ക്കിടയിൽ കണ്ണിൽപ്പെട്ട ചില കാഴ്ചകൾ. വലുതായി കാണാൻ ഏതെങ്കിലും ചിത്രം തുറക്കൂ.">A few things I noticed along the way. Tap any frame to see it up close.</p></div>
      <div class="filters" id="filters" aria-label="Filter photographs"></div>
      <div class="gallery" id="galleryGrid"></div>
    </section>
    <section class="about" id="about"><div class="shell about-inner"><div class="reveal"><div class="eyebrow" data-en="A LITTLE ABOUT THIS SPACE" data-ml="ഈ ഇടത്തെക്കുറിച്ച്">A LITTLE ABOUT THIS SPACE</div><h2 data-en-html="Looking closer.<br><em>Feeling more.</em>" data-ml-html="കൂടുതൽ കാണാം.<br><em>അനുഭവിക്കാം.</em>">Looking closer.<br><em>Feeling more.</em></h2></div><div class="about-copy reveal"><p data-en="Hello, I’m Albin. This page is a home for the photographs and visual notes I’ve shared — scenes from the road, the sky, familiar places, and the quiet in between." data-ml="ഹായ്, ഞാൻ ആൽബിൻ. ഞാൻ പങ്കുവെച്ച ഫോട്ടോകൾക്കും ദൃശ്യ കുറിപ്പുകൾക്കുമുള്ള ഒരിടമാണിത് — വഴികളും ആകാശവും പരിചിത ഇടങ്ങളും അവയ്ക്കിടയിലെ നിശ്ശബ്ദതയും.">Hello, I’m Albin. This page is a home for the photographs and visual notes I’ve shared — scenes from the road, the sky, familiar places, and the quiet in between.</p><p data-en="Take your time, wander through the frames, and find a moment that feels like yours." data-ml="സാവധാനം ചിത്രങ്ങളിലൂടെ നടക്കൂ. നിങ്ങളുടേതെന്ന് തോന്നുന്ന ഒരു നിമിഷം കണ്ടെത്തൂ.">Take your time, wander through the frames, and find a moment that feels like yours.</p><div class="signature">— Albin Baby</div></div></div></section>
    <section class="connect shell" id="connect"><div class="eyebrow" data-en="MORE WHERE THESE CAME FROM" data-ml="ഇനിയും കാഴ്ചകൾ">MORE WHERE THESE CAME FROM</div><h2 class="reveal" data-en-html="Let’s keep in <em>touch.</em>" data-ml-html="നമുക്ക് <em>കാണാം.</em>">Let’s keep in <em>touch.</em></h2><p class="reveal" data-en="Follow along on Instagram for more photographs, everyday moments, and new things I’m noticing." data-ml="കൂടുതൽ ഫോട്ടോകൾക്കും ദിവസേനയുള്ള ചെറിയ കാഴ്ചകൾക്കും ഇൻസ്റ്റഗ്രാമിൽ കൂടെ വരൂ.">Follow along on Instagram for more photographs, everyday moments, and new things I’m noticing.</p><a class="button" href="https://www.instagram.com/albin___baby___?rpxt=MTN4cXprb3A2dm8ybg==" target="_blank" rel="noreferrer"><span data-en="FOLLOW ON INSTAGRAM" data-ml="ഇൻസ്റ്റഗ്രാമിൽ പിന്തുടരൂ">FOLLOW ON INSTAGRAM</span><span aria-hidden="true">↗</span></a></section>
  </main>
  <footer class="footer shell"><span>© <span id="year"></span> Albin Baby</span><a href="#home" data-en="BACK TO TOP ↑" data-ml="മുകളിലേക്ക് ↑">BACK TO TOP ↑</a><span data-en="Made of moments & light" data-ml="നിമിഷങ്ങളും വെളിച്ചവും">Made of moments &amp; light</span></footer>
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photograph viewer"><button class="close" id="closeLightbox" aria-label="Close">×</button><button class="prev" id="prevPhoto" aria-label="Previous photograph">‹</button><img id="lightboxImage" alt=""><button class="next" id="nextPhoto" aria-label="Next photograph">›</button><div class="lightbox-caption" id="lightboxCaption"></div></div>
  <script>
    const posts = [
      ['682714156_18080511263453028_5958498540099066278_n.jpg','moments'],['670426207_18078834347453028_2271564453530594372_n.jpg','places'],['820106890_18095988884453028_4649105561680879620_n.jpg','nature'],['704565031_18082826120453028_1847717598838751717_n.jpg','moments'],['654862792_18082424522453028_3160269812915683880_n.jpg','nature'],['696272931_18082217204453028_2703843214821880413_n.jpg','moments'],['671203116_18079568009453028_1008151517063336598_n.jpg','nature'],['670644267_18078864395453028_8775113312888808134_n.jpg','places'],['643005436_18073787924453028_4286240750217102482_n.jpg','nature'],['627912955_18072461948453028_1120487593822857481_n.jpg','moments'],['626216131_18071505287453028_8525997087375831090_n.jpg','nature'],['619763098_18070189568453028_3565392790270773229_n.jpg','moments'],['581689128_18064603373453028_4110664539708228941_n.jpg','places'],['581677098_18064516793453028_8064878307599736585_n.jpg','nature'],['546489922_18056940461453028_5967899359882619952_n.jpg','moments'],['662230961_18111522058826044_8867794748609427057_n.jpg','places'],['656274222_18109257424695616_6490286496815472439_n.jpg','places'],['801786329_18094612655453028_8790256811137567456_n.jpg','words'],['775458563_18092025563453028_1024927670752839925_n.jpg','words'],['628280293_18426166822137902_7645477809693257077_n.jpg','places'],['624551610_18101702479870325_5633699858154970660_n.jpg','portrait'],['625524411_18194576884341807_7236843086742108009_n.jpg','words'],['653566724_17938869165016545_7607679158410242233_n.jpg','places'],['623989011_18074800388613346_2172342879668691028_n.jpg','nature'],['632553470_18330540295175073_7310948058054793656_n.jpg','words'],['638856948_18378234589089346_3684438101607980047_n.jpg','words'],['623977070_18084625699909341_8399940937816108440_n.jpg','portrait'],['632317427_18401685343183651_8057383195862420204_n.jpg','places'],['637276878_18390298207149664_2793100212943653872_n.jpg','nature'],['625248768_18098911777808244_1624790002477368954_n.webp','words'],['651788662_18102284194904129_5544023190182052812_n.webp','nature'],['621136798_18134717107496952_5279723439753924635_n.jpg','nature'],['624535835_18159623392414554_4641177018627862299_n.jpg','moments']
    ].map(([file,category],index)=>({file,category,index}));
    const copy={en:{all:'All frames',nature:'Nature',places:'Places',portrait:'Portraits',words:'Words & thoughts',moments:'Moments'},ml:{all:'എല്ലാം',nature:'പ്രകൃതി',places:'ഇടങ്ങൾ',portrait:'പോർട്രെയ്റ്റ്',words:'വാക്കുകൾ',moments:'നിമിഷങ്ങൾ'}};
    let currentFilter='all', currentLanguage='en', currentIndex=0;
    const grid=document.getElementById('galleryGrid'), filterBox=document.getElementById('filters'), lightbox=document.getElementById('lightbox');
    const categoryName=(cat)=>copy[currentLanguage][cat]||copy[currentLanguage].moments;
    function renderFilters(){filterBox.innerHTML=['all','nature','places','portrait','words','moments'].map(cat=>`<button class="filter${currentFilter===cat?' active':''}" data-filter="${cat}">${copy[currentLanguage][cat]}</button>`).join('');filterBox.querySelectorAll('button').forEach(btn=>btn.addEventListener('click',()=>{currentFilter=btn.dataset.filter;renderFilters();renderGrid()}))}
    function renderGrid(){grid.innerHTML=posts.map((post,i)=>`<article class="card" data-category="${post.category}" data-index="${i}" tabindex="0" role="button" aria-label="${categoryName(post.category)} — open photograph"><img src="images/${post.file}" alt="${categoryName(post.category)} photograph ${String(i+1).padStart(2,'0')}" loading="lazy"><div class="card-info"><span class="card-category">${categoryName(post.category)}</span><span class="card-number">${String(i+1).padStart(2,'0')}</span></div><span class="card-arrow" aria-hidden="true">↗</span></article>`).join('');grid.querySelectorAll('.card').forEach(card=>{card.hidden=currentFilter!=='all'&&card.dataset.category!==currentFilter;card.addEventListener('click',()=>openLightbox(+card.dataset.index));card.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openLightbox(+card.dataset.index)}})})}
    function openLightbox(i){currentIndex=i;updateLightbox();lightbox.classList.add('open');document.body.style.overflow='hidden';document.getElementById('closeLightbox').focus()}
    function updateLightbox(){const post=posts[currentIndex];document.getElementById('lightboxImage').src=`images/${post.file}`;document.getElementById('lightboxImage').alt=`${categoryName(post.category)} photograph ${String(currentIndex+1).padStart(2,'0')}`;document.getElementById('lightboxCaption').textContent=`${categoryName(post.category)} · ${String(currentIndex+1).padStart(2,'0')} / ${posts.length}`}
    function closeLightbox(){lightbox.classList.remove('open');document.body.style.overflow=''}
    document.getElementById('closeLightbox').addEventListener('click',closeLightbox);document.getElementById('prevPhoto').addEventListener('click',()=>{currentIndex=(currentIndex+posts.length-1)%posts.length;updateLightbox()});document.getElementById('nextPhoto').addEventListener('click',()=>{currentIndex=(currentIndex+1)%posts.length;updateLightbox()});lightbox.addEventListener('click',e=>{if(e.target===lightbox)closeLightbox()});document.addEventListener('keydown',e=>{if(!lightbox.classList.contains('open'))return;if(e.key==='Escape')closeLightbox();if(e.key==='ArrowRight'){currentIndex=(currentIndex+1)%posts.length;updateLightbox()}if(e.key==='ArrowLeft'){currentIndex=(currentIndex+posts.length-1)%posts.length;updateLightbox()}});
    function setLanguage(lang){currentLanguage=lang;document.documentElement.lang=lang;document.body.classList.toggle('ml',lang==='ml');document.querySelectorAll('[data-en]').forEach(el=>el.textContent=el.dataset[lang]);document.querySelectorAll('[data-en-html]').forEach(el=>el.innerHTML=el.dataset[lang+'Html']);document.querySelectorAll('[data-lang]').forEach(btn=>{const active=btn.dataset.lang===lang;btn.classList.toggle('active',active);btn.setAttribute('aria-pressed',String(active))});renderFilters();renderGrid();if(lightbox.classList.contains('open'))updateLightbox()}
    document.querySelectorAll('[data-lang]').forEach(btn=>btn.addEventListener('click',()=>setLanguage(btn.dataset.lang)));
    const menu=document.getElementById('nav'), menuToggle=document.getElementById('menuToggle');menuToggle.addEventListener('click',()=>{const open=menu.classList.toggle('open');menuToggle.setAttribute('aria-expanded',String(open));menuToggle.textContent=open?'×':'☰'});menu.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.classList.remove('open');menuToggle.setAttribute('aria-expanded','false');menuToggle.textContent='☰'}));
    document.getElementById('year').textContent=new Date().getFullYear();renderFilters();renderGrid();
    const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target)}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
  </script>
</body>
</html>